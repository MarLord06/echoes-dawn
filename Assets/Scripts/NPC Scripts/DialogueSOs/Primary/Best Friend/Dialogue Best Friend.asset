  lines:
  - speaker: {fileID: 11400000, guid: 67ca6e642e709984da1fc85bf7215277, type: 2}
    text: "\xA1Por fin te levantaste! "
  - speaker: {fileID: 11400000, guid: 67ca6e642e709984da1fc85bf7215277, type: 2}
    text: "Ya casi cre\xEDa que ibas a dejar pasar el gran d\xEDa"
  - speaker: {fileID: 11400000, guid: 67ca6e642e709984da1fc85bf7215277, type: 2}
    text: "Y s\xED, barr\xED el camino hasta tu casa por quinta vez"
  - speaker: {fileID: 11400000, guid: 67ca6e642e709984da1fc85bf7215277, type: 2}
    text: ' Me debes una limonada... o tres'
