  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 547d8b0914934cb4fa82923063fbf10f, type: 3}
  m_Name: Dialogo Secta2
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "En el principio fue el Kernel\u2026"
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "Linus lo entreg\xF3, y los sabios lo distribuyeron"
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "Naci\xF3 Ubuntu, luego Arch, y luego los que creen que compilar todo es
      iluminador"
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: Algunos cayeron en Debian. Otros subieron al Manjaro celestial
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "Pero todos siguen el camino del c\xF3digo libre"
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "\xBFT\xFA qu\xE9 eliges? \xBFPermanecer en la ignorancia\u2026 o escribir
      tu destino en Bash?"
  options:
  - optionText: Me interesa, hablame mas
    nextDialogue: {fileID: 11400000, guid: a157166d9385a404eb6ae0794668559b, type: 2}
  - optionText: No gracias
    nextDialogue: {fileID: 11400000, guid: b782fc8b6b3a31846b5d00e252da7aa9, type: 2}
