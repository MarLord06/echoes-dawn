  m_Script: {fileID: 11500000, guid: 547d8b0914934cb4fa82923063fbf10f, type: 3}
  m_Name: Dialogo Secta1_No gracias
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "No todos est\xE1n listos para dejar la comodidad de sus interfaces gr\xE1ficas\u2026"
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "Pero cuando tu sistema crashee por una actualizaci\xF3n nocturna"
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "recuerda mis palabras: En Linux, t\xFA eras el error\u2026 pero tambi\xE9n
      la soluci\xF3n"
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "Te esperar\xE9. Siempre..."
  options: []
