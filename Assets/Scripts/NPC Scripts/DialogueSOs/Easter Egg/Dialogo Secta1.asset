  m_Script: {fileID: 11500000, guid: 547d8b0914934cb4fa82923063fbf10f, type: 3}
  m_Name: Dialogo Secta1
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "Pssst\u2026 t\xFA\u2026 s\xED, t\xFA. Te he visto abrir esa terminal oculta"
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "Eso solo lo hacen los que sienten\u2026 la Llamada del Pinguino"
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "\xBFTodav\xEDa usas ventanas? Pobrecito\u2026 no sabes lo que es la libertad
      real"
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "Aqu\xED no hay licencias que leer, ni reinicios forzados"
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "Aqu\xED t\xFA eres el root\u2026 el due\xF1o absoluto"
  - speaker: {fileID: 11400000, guid: ee03e3ef69d5a734fbb2f3303d331592, type: 2}
    text: "\xA1\xDAnete a nosotros! El comando es simple: apt install iluminaci\xF3n"
  options:
  - optionText: Me interesa
    nextDialogue: {fileID: 11400000, guid: 787bbe63d2c0c1b4e84b804865156379, type: 2}
  - optionText: No gracias
    nextDialogue: {fileID: 11400000, guid: a0218494ed43c924aa0ab6215706af76, type: 2}
